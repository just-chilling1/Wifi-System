# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# macOS AppleDouble resource forks (common on external drives)
._*

# dependencies
/node_modules

# next.js
/.next/
/out/

# production
/build

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel
.env*

# training video pipeline (thumbnails only)
training-video-system/**
!training-video-system/wifi-code/
training-video-system/wifi-code/**
!training-video-system/wifi-code/thumbnails/
!training-video-system/wifi-code/thumbnails/**

# never commit raw video / audio assets
*.mp4
*.webm
*.mov
*.avi
*.mkv
*.mp3
*.wav
*.m4a
*.aac
*.flac
*.ogg
*.aiff
*.wma
